extends layout

block content
  h1#wb-cont(property="name")= title
  ul
    each item in clause_list
      li
        a(href=item.url) #{item.number} #{item.name}

    else
      li There are no clauses to display.

  a(href='/edit/clause/create') Create clause
  <br>

  a(href='/edit/clausesdownload') Download clause list as JSON
  <br>
  a(href="#modal-uploadJSON" aria-controls="modal-uploadJSON" class="wb-lbx lbx-modal" id="restoreModal") Upload JSON and restore clause list

  section(id="modal-uploadJSON" class="mfp-hide modal-dialog modal-content overlay-def")
    header(class="modal-header")
      h2(class="modal-title") Upload JSON and restore clause list
    div(class="modal-body" id="dialog")
      p#dialog-text(aria-live="polite") Note: By uploading and submitting a JSON file, you will modify the clause database to be an exact copy of your JSON file. The data from the previous database will be unrecoverable so be sure to make a copy of the current database if you think you will need it in the future.
      form(action='/edit/clausesrestore' method="post" enctype="multipart/form-data", id="form")
        label(for="fileInput") Upload clause JSON file
        input(type="file" id="fileInput" accept="application/json")
        button(type="submit" id="modal-submit-button" aria-disabled="true") Submit
      div(class="modal-footer")
        button(id="cancel-overlay" class="btn btn-primary pull-left popup-modal-dismiss" type="button") Cancel
