extends layout

block content
  h1#wb-cont(property="name")= title
  
  h2 Step 1 questions
  - const step1 = item_list.filter(i => i.isUber === true)
  if step1.length > 0
    ul
      each item in step1
        li
          a(href=item.url) #{item.name}
  else
    p There are no Step 1 questions to display.

  h2 Step 2 questions
  - const step2 = item_list.filter(i => i.isUber === false && i.isUnique === false)
  if step2.length > 0
    ul
      each item in step2
        li
          a(href=item.url) #{item.name}
  else
    p There are no Step 2 questions to display.

  h2 Step 3 questions
  - const step3 = item_list.filter(i => i.isUnique === true)
  if step3.length > 0
    ul
      each item in step3
        li
          a(href=item.url) #{item.name}
  else
    p There are no Step 3 questions to display.

  a(href='/edit/question/create') Create question
  <br>

  a(href="/edit/questionsdownload" ) Download question list as JSON
  <br>
  a(href="#modal-uploadJSON" aria-controls="modal-uploadJSON" class="wb-lbx lbx-modal" id="restoreModal") Upload JSON and restore question list

  section(id="modal-uploadJSON" class="mfp-hide modal-dialog modal-content overlay-def")
    header(class="modal-header")
      h2(class="modal-title") Upload JSON and restore question list
    div(class="modal-body" id="dialog")
      p#dialog-text(aria-live="polite") Note: By uploading and submitting a JSON file, you will modify the question database to be an exact copy of your JSON file. The data from the previous database will be unrecoverable so be sure to make a copy of the current database if you think you will need it in the future.
      form(action ='/edit/questionsrestore' method="post" enctype="multipart/form-data", id="form")
        label(for= "fileInput") Upload question JSON file
        input(type="file" id="fileInput" accept="application/json")
        button(type="submit" id="modal-submit-button" aria-disabled="true") Submit
      div(class="modal-footer")
        button(id="cancel-overlay" class="btn btn-primary pull-left popup-modal-dismiss" type="button") Cancel
